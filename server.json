{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smythmyke/jackpotkeywords-mcp-server",
  "description": "AI-powered keyword research and AI-visibility scans via the JackpotKeywords REST API.",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/smythmyke/JackpotKeywords",
    "source": "github",
    "subfolder": "mcp-server"
  },
  "websiteUrl": "https://jackpotkeywords.web.app",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "jackpotkeywords-mcp-server",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JACKPOTKEYWORDS_API_KEY",
          "description": "API key from https://jackpotkeywords.web.app/developers. Required.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "JACKPOTKEYWORDS_API_BASE",
          "description": "Override the API base URL. Default: https://jackpotkeywords.web.app/api/v1",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
